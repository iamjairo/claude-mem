# claude-mem MongoDB Docker stack — env vars
# Copy this file to .env.mongodb and fill in your values:
#   cp .env.mongodb.example .env.mongodb

# ── Required ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── MongoDB credentials (optional — only needed if you uncomment auth in compose) ──
# MONGO_ROOT_USER=claude
# MONGO_ROOT_PASSWORD=changeme

# ── mongo-express UI credentials ───────────────────────────────────────────
ME_ADMIN_USER=admin
ME_ADMIN_PASSWORD=changeme

# ── Worker port (default 37777) ─────────────────────────────────────────────
# CLAUDE_MEM_WORKER_PORT=37777

# ── Additional API keys (optional) ─────────────────────────────────────────
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
